{
  "name": "web-toolbox-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "web-toolbox MCP bridge: exposes the browser extension to any MCP client over a local WebSocket.",
  "type": "module",
  "bin": {
    "web-toolbox-bridge": "./src/index.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "doctor": "node ./src/doctor.js",
    "unit": "node ./unit.mjs",
    "exporters": "node ./test-exporters.mjs",
    "smoke": "node ./smoke.mjs",
    "test": "node ./unit.mjs && node ./test-exporters.mjs && node ./test-doctor.mjs && node ./test-reconnect.mjs && node ./smoke.mjs",
    "doctorE2e": "node ./test-doctor.mjs",
    "reconnect": "node ./test-reconnect.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^3.25.0"
  }
}
