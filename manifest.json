{
  "manifest_version": 3,
  "name": "Web 工具箱",
  "version": "1.1.0",
  "description": "免 F12 录制接口流量,导出 JMeter/Python/HAR;可让 Claude Code 等 AI 客户端通过 MCP 抓包与操作页面。",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "scripting",
    "debugger",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Web 工具箱"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
